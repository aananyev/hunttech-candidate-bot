# HuntTech Candidate Bot — переменные окружения
# Скопируйте в .env и заполните значения

# ══════════════════════════════════════════════════════════════
# Telegram Bot Token (обязательно)
# Получите у @BotFather
# ══════════════════════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=

# ══════════════════════════════════════════════════════════════
# AI настройки (обязательно для парсинга резюме)
# ══════════════════════════════════════════════════════════════
# Endpoint AI-провайдера (DeepSeek по умолчанию)
AI_ENDPOINT=https://api.deepseek.com/v1
# API ключ (получите на платформе провайдера)
AI_API_KEY=
# Модель
AI_MODEL=deepseek-chat
# Таймаут запросов (секунды)
AI_TIMEOUT=120

# ══════════════════════════════════════════════════════════════
# База данных PostgreSQL (PG11)
# Локальная тестовая БД: postgresql://cuba:cuba@127.0.0.1:5432/hunttech?sslmode=disable
# Прод: через SSH туннель (настройте через /setup db)
# ══════════════════════════════════════════════════════════════
DATABASE_URL=

# ══════════════════════════════════════════════════════════════
# Администраторы бота
# ══════════════════════════════════════════════════════════════
# Главный администратор (суперпользователь, владелец бота)
MASTER_ADMIN_ID=272980897
# Дополнительные администраторы (через запятую)
ADMIN_IDS=272980897

# ══════════════════════════════════════════════════════════════
# Канал для публикаций (опционально)
# ══════════════════════════════════════════════════════════════
CHANNEL_ID=@hunttech_candidates